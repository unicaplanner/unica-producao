generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Um pedido do Shopify. Sincronizado 1x/dia; campos vindos do Shopify sao
// sempre sobrescritos na sincronizacao, mas o status de producao dos
// LineItems nunca e mexido pelo sync.
// Sem nome/email do cliente de proposito: a Shopify so libera PII de
// cliente via API nos planos Shopify/Advanced/Plus (a loja esta no Basic).
model Order {
  id          String   @id @default(cuid())
  shopifyId   String   @unique // gid://shopify/Order/123...
  name        String // "#1023"
  orderDate   DateTime // Shopify createdAt
  prazoLimite DateTime // orderDate + 15 dias uteis, recalculado a cada sync

  financialStatus   String? // paid, pending, partially_paid...
  fulfillmentStatus String? // unfulfilled, partial, fulfilled...
  cancelledAt       DateTime?
  closedAt          DateTime?

  // false quando o pedido nao veio mais na ultima sincronizacao com
  // query "status:open" -- ou seja, foi cumprido ou cancelado no Shopify.
  // E o jeito de saber que um pedido saiu do estado "aberto" sem ter que
  // reconsultar cada um individualmente.
  stillOpenInShopify Boolean @default(true)

  totalPrice String // Decimal do Shopify vem como string
  currency   String

  shippingMethod String? // nome do frete escolhido no checkout (ex: "PAC", "Sedex")

  adminUrl String // link direto pro pedido no admin do Shopify

  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  lineItems LineItem[]

  // Caixa fisica de envio. Varios pedidos podem compartilhar a mesma caixa
  // (cliente que comprou em pedidos separados e a gente agrupa pra mandar
  // junto). Nulo = pedido ainda nao entrou em nenhuma caixa.
  boxId String?
  box   Box?    @relation(fields: [boxId], references: [id])

  @@index([fulfillmentStatus])
  @@index([prazoLimite])
}

// O checklist de embalagem/envio vive na caixa, nao no pedido -- pedidos
// agrupados na mesma caixa compartilham o mesmo status (uma caixa so pode
// ser despachada uma vez, por exemplo).
model Box {
  id     String @id @default(cuid())
  numero Int    @default(autoincrement()) // exibido como "Caixa 1", "Caixa 2"...

  montada          Boolean @default(false)
  finalizada       Boolean @default(false)
  notaFiscalGerada Boolean @default(false)
  etiquetaGerada   Boolean @default(false)
  despachado       Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
}

enum StatusProducao {
  pendente
  produzido
}

// Um item de linha de um pedido. E aqui que mora o rastreio de producao,
// o unico dado que o Shopify nao sabe e que precisa persistir entre syncs.
model LineItem {
  id        String @id @default(cuid())
  shopifyId String @unique // gid://shopify/LineItem/123...

  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  title        String
  variantTitle String?
  sku          String?
  quantity     Int

  // Texto de personalizacao gravado por apps do produto (ex: "text-1: Fé"),
  // vindo de LineItem.customAttributes no Shopify. Array de {key, value},
  // ja filtrado das chaves internas de apps (que comecam com "_").
  customAttributes Json?

  statusProducao StatusProducao @default(pendente)
  dataProducao   DateTime?

  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([statusProducao])
  @@index([title])
}

// Informacoes cadastradas a mao por produto na visao "Agrupado por item".
// A chave e a mesma do grupo na tela ("titulo::variante"), entao valem pra
// esse produto+variante e nao dependem de pedido nenhum.
model ProductInfo {
  id  String @id @default(cuid())
  key String @unique

  printUrl String? // PDF de impressao: link http/https ou caminho local do computador
  siteUrl  String? // pagina do produto no site
  specs    String? // especificacoes do produto (texto livre)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Link do produto no site (onlineStoreUrl), puxado do Shopify na
// sincronizacao -- alimenta o "Link do site" automatico na tela Agrupado
// por item. So isso; estoque em si e gerenciado fora daqui, no Mundo Unica.
model ShopifyProduct {
  id               String  @id @default(cuid())
  shopifyProductId String  @unique // gid://shopify/Product/123...
  title            String
  url              String? // onlineStoreUrl, nulo se o produto nao esta publicado

  lastSyncedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([title])
}
