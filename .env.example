# Banco de dados Postgres (Vercel Postgres, Neon ou Supabase).
# Use a connection string DIRETA (nao a com pgbouncer/"pooled"), tanto aqui
# quanto na Vercel -- e o que "prisma db push" e o app em runtime usam.
DATABASE_URL="postgres://user:password@host/db?sslmode=require"

# App customizado no Shopify (Admin > Apps e canais de vendas > Desenvolver apps)
# com escopo de leitura read_orders.
SHOPIFY_STORE_DOMAIN="sua-loja.myshopify.com"
SHOPIFY_ADMIN_ACCESS_TOKEN="shpat_..."

# Autenticacao simples da Central de Producao (usuaria unica).
APP_PASSWORD="escolha-uma-senha"
APP_SECRET="uma-string-aleatoria-longa-so-para-assinar-o-cookie"

# Protege o endpoint /api/cron/sync -- a Vercel manda esse valor sozinha
# no header Authorization quando CRON_SECRET esta configurado no projeto.
CRON_SECRET="outra-string-aleatoria-longa"
